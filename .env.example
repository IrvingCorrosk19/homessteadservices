NEXT_PUBLIC_SITE_URL=https://homestead.lat
NEXT_PUBLIC_EMAIL=servicios@homestead.lat

# Completar cuando existan datos reales. No inventar valores.
NEXT_PUBLIC_PHONE=
# Public WhatsApp Business CTAs — keep false until official WA Business is ready.
NEXT_PUBLIC_WHATSAPP_PUBLIC_ENABLED=false
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_HOURS=8:00 a.m. a 10:00 p.m.
NEXT_PUBLIC_SERVICE_AREA=Todo Panamá
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_FACEBOOK=

# Destino de las solicitudes del formulario
CONTACT_INBOX=servicios@homestead.lat
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_USER=servicios@homestead.lat
SMTP_PASS=

# n8n (server-to-server only; never expose to the browser)
N8N_HOMESTEAD_WEBHOOK_URL=
N8N_HOMESTEAD_WEBHOOK_SECRET=
DATA_DIR=

# Mini CRM admin (server-only)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Content Studio (server-only; never expose to the browser)
CONTENT_STUDIO_ENABLED=true
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-1
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
HOMESTEAD_TELEGRAM_CHAT_ID=
HOMESTEAD_TELEGRAM_ADMIN_CHAT_IDS=

# Smart Content Autopilot (ASSISTED + DRY RUN until Meta tokens exist)
CONTENT_MODE=ASSISTED
CONTENT_DRY_RUN=true
CONTENT_TIMEZONE=America/Panama
MARKETING_INTELLIGENCE_SHADOW=true
MARKETING_INTELLIGENCE_DRY_RUN=true
AI_CONCIERGE_ENABLED=true
AI_CONCIERGE_DRY_RUN=true
# Valid contact still creates the canonical HS lead and internal Telegram.
# Set false only as an emergency freeze.
AI_CONCIERGE_CREATE_LEADS=true
HOT_LEAD_ATTENTION_MINUTES=30
APPOINTMENT_REMINDER_ENABLED=true
APPOINTMENT_REMINDER_OFFSETS=24h,2h
# Empty uses revenue-engine.json businessHours.timezone
HOMESTEAD_TIMEZONE=
REVENUE_ENGINE_ENABLED=true
REVENUE_ENGINE_DRY_RUN=true
AUTO_FOLLOW_UP=false
REVENUE_BRIEFING_SEND=false
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=

# Autonomous Operations (server-only; safe pre-launch defaults)
AUTONOMOUS_OPERATIONS_ENABLED=true
AUTONOMOUS_NOTIFICATIONS_ENABLED=true
AUTONOMOUS_LOW_RISK_ACTIONS_ENABLED=false
AUTONOMOUS_OPERATIONS_DRY_RUN=true
AUTONOMOUS_AI_ENRICHMENT=true
AUTONOMOUS_DEFAULT_LEVEL=NOTIFY_ONLY
AUTONOMOUS_REQUEST_AGING_HOURS=24
AUTONOMOUS_UPCOMING_HOURS=24
AUTONOMOUS_PREVISIT_HOURS=24
AUTONOMOUS_NOTIFY_COOLDOWN_MINUTES=60
AUTONOMOUS_ACK_REMINDER_HOURS=24
AUTONOMOUS_MORNING_BRIEF_HOUR=7
AUTONOMOUS_EOD_BRIEF_HOUR=18
AUTONOMOUS_MAX_SIGNALS_PER_SCAN=200
AUTONOMOUS_MAX_AI_ENRICH_PER_SCAN=10
AUTONOMOUS_ACTION_TOKEN_TTL_MINUTES=30
