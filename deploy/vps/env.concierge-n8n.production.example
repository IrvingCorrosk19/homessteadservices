# Homestead Concierge n8n — PRODUCTION example (NO real secrets)
# Merge into deploy/vps/.env on the VPS only after backup + workflow import.
# Defaults below keep the previous engine until you intentionally flip the flag.

# --- Homestead web (homestead_web) ---
AI_CONCIERGE_ENABLED=true
# Keep legacy until Phase 5 (activation). Existing unpinned threads with history stay legacy via code pin.
AI_CONCIERGE_ENGINE=legacy
AI_CONCIERGE_N8N_MODE=remote
AI_CONCIERGE_DRY_RUN=false
AI_CONCIERGE_CREATE_LEADS=true
AI_CONCIERGE_TURN_TIMEOUT_MS=45000

# Long random (≥32 chars). Must MATCH n8n Variable CONCIERGE_INTERNAL_SECRET.
# Generate on VPS: openssl rand -hex 32
CONCIERGE_INTERNAL_SECRET=replace-with-openssl-rand-hex-32

# Private Docker network to shared n8n (same pattern as Control Push).
# Do NOT use the public TLS hostname for this hop if the cert is stale.
N8N_CONCIERGE_TURN_WEBHOOK_URL=http://n8n:5678/webhook/homestead-concierge-turn

# --- n8n Variables UI (Settings → Variables) — names only; set values in UI ---
# CONCIERGE_INTERNAL_SECRET = <same as Homestead CONCIERGE_INTERNAL_SECRET>
# HOMESTEAD_INTERNAL_BASE   = http://homestead_web:3000
#
# Do NOT put Meta/Telegram tokens into this workflow.
# Do NOT edit Telegram / Content Studio / Control Push workflows for this rollout.

# Workflow file to import (inactive):
#   n8n/homestead-n8n-concierge-turn.prod.json
