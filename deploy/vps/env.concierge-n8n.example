# Homestead Concierge n8n engine — EXAMPLE ONLY (no secrets)
# Isolated local: keep MODE=local. Production VPS: see env.concierge-n8n.production.example
# and docs/DEPLOY/HOMESTEAD-CONCIERGE-N8N-GO-LIVE.md

AI_CONCIERGE_ENABLED=true
AI_CONCIERGE_ENGINE=n8n
AI_CONCIERGE_N8N_MODE=local
AI_CONCIERGE_DRY_RUN=true
AI_CONCIERGE_CREATE_LEADS=true
AI_CONCIERGE_TURN_TIMEOUT_MS=45000

CONCIERGE_INTERNAL_SECRET=replace-with-long-random

# Isolated remote n8n (portable Node / :5679) — not shared VPS n8n:
# AI_CONCIERGE_N8N_MODE=remote
# N8N_CONCIERGE_TURN_WEBHOOK_URL=http://127.0.0.1:5679/webhook/homestead-concierge-turn
# HOMESTEAD_INTERNAL_BASE=http://127.0.0.1:3095
# CONCIERGE_INTERNAL_SECRET must match n8n env (store outside repo, e.g. data/n8n-isolated/.secret)

# Production shared n8n uses $vars — import n8n/homestead-n8n-concierge-turn.prod.json

NEXT_PUBLIC_PHONE=+507 6000-1111
NEXT_PUBLIC_OFFICIAL_WHATSAPP=true

# Isolated data root (never production DATA_DIR)
# DATA_DIR=/opt/apps/homestead-staging/data
# HOMESTEAD_CONTROL_ISOLATED=true
