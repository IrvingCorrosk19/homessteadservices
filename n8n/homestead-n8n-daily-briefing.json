{
  "name": "HOMESTEAD — Daily Business Briefing",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "hours", "hoursInterval": 24 }] } },
      "id": "hs-rev-day-trigger",
      "name": "Cada 24 horas",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://homestead.lat/api/internal/revenue/daily-briefing",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "X-Homestead-Webhook-Secret", "value": "={{ $vars.HOMESTEAD_WEBHOOK_SECRET }}" },
            { "name": "X-Homestead-Timestamp", "value": "={{ $now.toUnixInteger() }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event: 'revenue.daily.briefing' }) }}",
        "options": { "timeout": 25000 }
      },
      "id": "hs-rev-day-http",
      "name": "Homestead briefing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [460, 300],
      "continueOnFail": true
    }
  ],
  "connections": {
    "Cada 24 horas": { "main": [[{ "node": "Homestead briefing", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "availableInMCP": false },
  "pinData": {},
  "active": false
}
